    "cbd.int": {
      "display": "CBD Secretariat",
      "category": "biodiversity_abs",
      "tier": "primary",
      "jurisdiction": "international",
      "covers": ["convention_on_biological_diversity", "nagoya_protocol", "abs_international"]
    },
    "wipo.int": {
      "display": "WIPO",
      "category": "international_ip",
      "tier": "primary",
      "jurisdiction": "international",
      "covers": ["pct", "madrid_system", "hague", "traditional_knowledge_framework", "wipo_treaties"]
    },
    "wto.org": {
      "display": "WTO / TRIPS",
      "category": "international_ip",
      "tier": "primary",
      "jurisdiction": "international",
      "covers": ["trips_agreement", "geographical_indications_international", "patent_flexibilities"]
    },
    "indiacode.nic.in": {
      "display": "India Code",
      "category": "indian_legislation",
      "tier": "secondary",
      "jurisdiction": "india",
      "covers": ["all_central_acts", "patents_act_1970", "trademarks_act_1999", "designs_act_2000", "copyright_act_1957", "biodiversity_act_2002", "drugs_cosmetics_act_1940", "plant_variety_act_2001", "geographical_indications_act_1999"]
    },
    "egazette.gov.in": {
      "display": "e-Gazette of India",
      "category": "indian_legislation",
      "tier": "secondary",
      "jurisdiction": "india",
      "covers": ["official_gazette_notifications", "statutory_rules", "amendments"]
    },
    "tkdl.res.in": {
      "display": "TKDL (CSIR)",
      "category": "traditional_knowledge",
      "tier": "primary",
      "jurisdiction": "india",
      "covers": ["traditional_knowledge_digital_library", "tkdl_prior_art", "classical_texts_digitised"]
    },
    "fssai.gov.in": {
      "display": "FSSAI",
      "category": "food_nutraceutical",
      "tier": "primary",
      "jurisdiction": "india",
      "covers": ["ayurveda_aahar", "nutraceuticals", "food_safety", "fssai_regulations", "label_claims"]
    },
    "plantauthority.gov.in": {
      "display": "Plant Variety Authority (PPVFRA)",
      "category": "plant_variety",
      "tier": "primary",
      "jurisdiction": "india",
      "covers": ["plant_variety_protection", "farmers_rights", "plant_breeders_rights"]
    },
    "niti.gov.in": {
      "display": "NITI Aayog",
      "category": "policy",
      "tier": "reference",
      "jurisdiction": "india",
      "covers": ["ayush_policy_documents", "ip_policy", "biodiversity_strategy"]
    },
    "pib.gov.in": {
      "display": "Press Information Bureau",
      "category": "policy",
      "tier": "reference",
      "jurisdiction": "india",
      "covers": ["official_government_announcements", "regulatory_updates"]
    },
    "indianpharmacycouncil.org": {
      "display": "Pharmacy Council of India",
      "category": "drug_regulatory",
      "tier": "reference",
      "jurisdiction": "india",
      "covers": ["pharmacy_practice", "drug_standards"]
    },
  },

