{
  "meta": {
    "version": "2.1",
    "description": "Approved source registry for Nyaaya AI / IP-SAKTI. All Perplexity search_domain_filter arrays and citation display names are derived from this file.",
    "trust_tiers": {
      "primary": "Official government portals and treaty bodies — highest authority",
      "secondary": "Statutory databases and official gazette — legislative authority",
      "reference": "Regulatory guidance portals — authoritative but may lag enactments"
    }
  },

  "domains": {
    "ipindia.gov.in": {
      "display": "IP India (CGPDTM)",
      "category": "patents_tm_designs",
      "tier": "primary",
      "jurisdiction": "india",
      "covers": ["patents", "trademarks", "designs", "geographical_indications"]
    },
    "eipo.gov.in": {
      "display": "e-IPO Portal",
      "category": "patents_tm_designs",
      "tier": "primary",
      "jurisdiction": "india",
      "covers": ["patents", "trademarks", "designs", "filings"]
    },
    "ayush.gov.in": {
      "display": "Ministry of AYUSH",
      "category": "ayush_regulations",
      "tier": "primary",
      "jurisdiction": "india",
      "covers": ["ayurveda_policy", "classical_formulations", "ayush_drug_rules"]
    },
    "cdsco.gov.in": {
      "display": "CDSCO",
      "category": "drug_regulatory",
      "tier": "primary",
      "jurisdiction": "india",
      "covers": ["drug_approvals", "new_drug", "clinical_trials", "manufacturing_licences", "schedule_y"]
    },
    "nbaindia.org": {
      "display": "National Biodiversity Authority",
      "category": "biodiversity_abs",
      "tier": "primary",
      "jurisdiction": "india",
      "covers": ["abs_compliance", "biodiversity_act", "access_and_benefit_sharing", "nagoya_india"]
