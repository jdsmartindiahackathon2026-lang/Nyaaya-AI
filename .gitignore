# Environment / secrets — never commit
.env
.env.local
.env*.local
*.env
frontend/.env.local
frontend/.env*.local

# Python (legacy — no longer used)
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Node
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/

# Supabase local dev
supabase/.branches/
supabase/.temp/

# OS
.DS_Store

# Ingest pipeline — raw scrapes and embeddings are heavy and regeneratable;
# only the pre-embedding chunks/*.jsonl files are committed as source of truth.
scraped/raw/
scraped/chunks/*.embedded.jsonl
ingest/.venv/
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Claude Code local settings
.claude/

# Scratchpad — session working files, never committed
scratchpad/

# TypeScript incremental build cache
*.tsbuildinfo

# Loose design assets dropped in frontend/ root (zips, videos, orphan images
# from design handoffs). Real assets live in frontend/public/.
frontend/*.zip
frontend/*.mp4
frontend/*.png
frontend/*.svg

# Internal working docs — kept locally, never committed to the public repo
context.md
progress.md
ENGINEERING_PRINCIPLES.md
ENGINEERING_PRINCIPLES_TEMPLATE.md
SECURITY_AUDIT_PLAYBOOK.md
SECURITY_AUDIT_PLAYBOOK_TEMPLATE.md
